# Dependencies + build outputs
node_modules
dist
dist-electron
dist-renderer
release
.vite

# Stale build stragglers at the project root (pre-v0.7.x layout when the
# renderer dropped index.html + hashed CSS/JS into the repo root by mistake).
# Real renderer entry lives at renderer/index.html.
/index.html
/index-*.css
/index-*.js

# Bundled web viewer — regenerated by `npm run webclient:bundle` (auto-runs
# from the predist hook). main/webclientHtml.js is the embedded copy the
# server ships; webclient/ is the intermediate build output.
webclient

# User-facing data folder (catalog DB + assets) lives at <dataDir> per
# CLAUDE.md §8. This entry catches the legacy `data/` runtime path.
data

# Logs, secrets, OS junk
*.log
.DS_Store
.env
.env.local

# Local Claude Code settings (per-Mac config; shared rules go in CLAUDE.md
# at the repo root). Keep the .claude/ directory itself trackable so we
# can commit non-local settings later without un-ignoring the whole tree.
.claude/settings.local.json
.claude/scheduled_tasks.lock
