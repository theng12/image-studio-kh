{
  "name": "image-studio-kh",
  "private": true,
  "version": "0.49.47",
  "description": "Image Studio KH — batch product image processor",
  "author": "TerraNash",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "cross-env ELECTRON_ENABLE_LOGGING=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "icon:build": "node scripts/build-icon.js",
    "webclient:bundle": "node scripts/build-webclient.js",
    "predist": "npm run webclient:bundle && npm run install:sharp-cross",
    "dist": "vite build && electron-builder",
    "release": "npm version patch --no-git-tag-version && npm run dist",
    "release:minor": "npm version minor --no-git-tag-version && npm run dist",
    "release:major": "npm version major --no-git-tag-version && npm run dist",
    "test": "node --test 'test/**/*.test.js'",
    "postinstall": "electron-builder install-app-deps",
    "install:sharp-cross": "npm install --no-save --include=optional --force @img/sharp-darwin-arm64@0.33.5 @img/sharp-libvips-darwin-arm64@1.0.4 @img/sharp-darwin-x64@0.33.5 @img/sharp-libvips-darwin-x64@1.0.4"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.5.5",
    "better-sqlite3": "^11.5.0",
    "bwip-js": "^4.10.1",
    "sharp": "^0.33.5",
    "ws": "^8.20.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.terranash.imagestudiokh",
    "productName": "Image Studio KH",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/bindings/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main/index.js"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0.0",
      "identity": null,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Image Studio KH ${version} (${arch})",
      "writeUpdateInfo": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis"
    }
  }
}
